; Function driver for one experimental PCI ID; never binds the boot display.
[Version]
Signature="$Windows NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/15/2026,0.0.2.0
CatalogFile=WinGpuDiagnostic.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Devices,NTarm64.10.0...22000
[Devices.NTarm64.10.0...22000]
%Name%=Install,PCI\VEN_1B36&DEV_FF10
[DestinationDirs]
DriverFiles=13
[SourceDisksNames]
1=%Disk%
[SourceDisksFiles]
WinGpuDiagnostic.sys=1
[Install.NT]
CopyFiles=DriverFiles
[Install.NT.HW]
AddReg=DeviceSecurity
[DeviceSecurity]
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"
[Install.NT.Services]
AddService=WinGpuDiagnostic,0x00000002,Service
[Install.NT.Wdf]
KmdfService=WinGpuDiagnostic,Wdf
[Wdf]
KmdfLibraryVersion=1.33
[DriverFiles]
WinGpuDiagnostic.sys
[Service]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\WinGpuDiagnostic.sys
[Strings]
Provider="WindowsiOS development"
Name="WindowsiOS Metal Command Diagnostics (no Direct3D)"
Disk="WindowsiOS experimental GPU diagnostics"
